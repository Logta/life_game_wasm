{
  "name": "life-game-wasm",
  "version": "0.1.0",
  "description": "A high-performance Conway's Game of Life implementation using WebAssembly and TypeScript",
  "author": "Life Game WASM Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/life-game-wasm"
  },
  "keywords": [
    "game-of-life",
    "conway",
    "webassembly",
    "wasm",
    "typescript",
    "rust",
    "simulation"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-name life_game_wasm",
    "build:ts": "tsc",
    "build": "bun run build:wasm && bun run build:ts && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "cargo test && wasm-pack test --headless && bun test src",
    "test:ts": "bun test src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "clean": "rm -rf dist pkg target node_modules/.vite"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "terser": "^5.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-wasm": "^3.6.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
